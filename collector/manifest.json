{
  "manifest_version": 3,
  "name": "Artkeep Collector",
  "version": "0.1.1",
  "description": "将 Pixiv 与 X 作品保存到 Artkeep 或本机",
  "key": "",
  "minimum_chrome_version": "124",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "offscreen",
    "scripting",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.pixiv.net/*",
    "https://*.pximg.net/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Artkeep Collector",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.pixiv.net/*"
      ],
      "js": [
        "ppd.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "x-observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.pixiv.net/*",
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "media",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
